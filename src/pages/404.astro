---
import Base from '../layouts/Base.astro';
import { ui, route } from '../lib/i18n';
const d = ui('fr');
---
<Base lang="fr" titre="Page introuvable" description={d.quatre.texte} alt={{ fr: '/', en: '/en/' }}>
  <section class="section container page-head">
    <p class="label">404</p>
    <h1>{d.quatre.titre}</h1>
    <p class="lede">{d.quatre.texte}</p>
    <p class="feature__actions"><a class="btn btn--ghost" href={route('fr', 'films')}>{d.accueil.tout_catalogue}</a> <a class="btn btn--ghost" href="/">Accueil</a></p>
  </section>
</Base>
