---
import Base from '../layouts/Base.astro';
import { ui, route, type Lang } from '../lib/i18n';
export function getStaticPaths() {
  const cles = ['carnet'] as const;
  const out = [] as { params: { attente: string }; props: { lang: Lang; cle: typeof cles[number] } }[];
  for (const lang of ['fr', 'en'] as Lang[]) {
    for (const cle of cles) {
      const chemin = route(lang, cle).replace(/^\/|\/$/g, '');
      out.push({ params: { attente: chemin }, props: { lang, cle } });
    }
  }
  return out;
}
const { lang, cle } = Astro.props as { lang: Lang; cle: string };
const d = ui(lang);
const titres: Record<string, string> = { films: d.nav.films, series: d.nav.series, univers: d.nav.univers, coulisses: d.nav.coulisses, methode: d.pied.methode, lexique: d.pied.lexique, carnet: 'Carnet', prestations: d.nav.prestations, apropos: lang === 'fr' ? 'À propos' : 'About', contact: d.nav.contact, mentions: d.pied.mentions, confidentialite: d.pied.confidentialite, roger: d.nav.roger };
const alt = { fr: route('fr', cle as any), en: route('en', cle as any) };
---
<Base lang={lang} titre={titres[cle]} description={d.site.description} alt={alt} current={cle}>
  <section class="section container">
    <h1>{titres[cle]}</h1>
    <p class="lede" style={undefined}>{lang === 'fr' ? 'Cette page est en cours d’écriture. Elle fait partie du lot 3 du chantier.' : 'This page is being written. It belongs to lot 3 of the build.'}</p>
  </section>
</Base>
