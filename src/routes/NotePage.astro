---
import Base from '../layouts/Base.astro';
import CartePiece from '../components/CartePiece.astro';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { ui, t, route, dateLongue, type Lang } from '../lib/i18n';
import { serieDe, estVisible, type Piece } from '../lib/content';
import { breadcrumb } from '../lib/jsonld';

interface Props { lang: Lang; note: CollectionEntry<'carnet'> }
const { lang, note } = Astro.props;
const d = ui(lang);
const slug = note.id.replace(/\.(fr|en)$/, '');
const { Content } = await render(note);
const notions = await getCollection('notions');
const titreNotion = (id: string) => { const n = notions.find((x) => x.id === id); return n ? t(lang, n.data.titre) : id; };
const pieces: Piece[] = [];
for (const id of note.data.pieces) { const p = await getEntry('pieces', id); if (p && estVisible(p)) pieces.push(p); }
const piecesSeries = await Promise.all(pieces.map(serieDe));
const url = route(lang, 'carnet', `${slug}/`);
const alt = { fr: route('fr', 'carnet', `${slug}/`), en: route('en', 'carnet', `${slug}/`) };
const jsonld = [
  breadcrumb([{ name: d.nav.coulisses, url: route(lang, 'coulisses') }, { name: d.carnet.titre, url: route(lang, 'carnet') }, { name: note.data.titre, url }]),
  { '@context': 'https://schema.org', '@type': 'Article', headline: note.data.titre, description: note.data.description, datePublished: note.data.date, dateModified: note.data.date, inLanguage: lang, author: { '@type': 'Organization', '@id': 'https://studio.madigitalagency.net/#organisation', name: 'M&A Digital Agency · Studio' }, url: 'https://studio.madigitalagency.net' + url, mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://studio.madigitalagency.net' + url }, image: ['https://studio.madigitalagency.net/partage-1200x630.jpg'] },
];
---
<Base lang={lang} titre={`${note.data.titre} · ${d.carnet.titre}`} description={note.data.description} alt={alt} jsonld={jsonld} current="coulisses">
  <article class="container page-texte">
    <header class="page-head">
      <nav class="fiche__crumb" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}><a href={route(lang, 'coulisses')}>{d.nav.coulisses}</a><span aria-hidden="true">/</span><a href={route(lang, 'carnet')}>{d.carnet.titre}</a></nav>
      <h1>{note.data.titre}</h1>
      <p class="lede">{note.data.description}</p>
      <p class="label num">{dateLongue(lang, note.data.date)}{note.data.etiquettes.length ? ` · ${note.data.etiquettes.join(' · ')}` : ''}</p>
    </header>
    <div class="prose page-texte__corps"><Content /></div>
    {note.data.notions.length > 0 && (
      <section class="block" style={undefined}>
        <h3 class="label">{d.fiche.aller_plus_loin}</h3>
        <ul class="notions">{note.data.notions.map((n) => <li><a href={route(lang, 'lexique', `${n}/`)}>{titreNotion(n)}</a></li>)}</ul>
      </section>
    )}
    {pieces.length > 0 && (
      <section class="section" aria-labelledby="note-vu">
        <div class="section__head"><h2 id="note-vu">{d.lexique.vu_dans_long}</h2></div>
        <div class="grid-cards">{pieces.map((p, i) => <CartePiece piece={p} serie={piecesSeries[i]} lang={lang} />)}</div>
      </section>
    )}
  </article>
  <script src="../scripts/cards.ts"></script>
</Base>
