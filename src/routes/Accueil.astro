---
import Base from '../layouts/Base.astro';
import CartePiece from '../components/CartePiece.astro';
import Lecteur from '../components/Lecteur.astro';
import Comparateur from '../components/Comparateur.astro';
import { ui, t, duree, numero, route, href, type Lang } from '../lib/i18n';
import { catalogue, seriesActives, universActifs, serieDe, urlPiece, urlSerie, formatDe, type Piece, media } from '../lib/content';
import { organisation } from '../lib/jsonld';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = ui(lang);

const pieces = await catalogue();
const une = pieces.find((p) => p.data.une) ?? pieces[0];
const uneSerie = une ? await serieDe(une) : undefined;
const dernieres = pieces.filter((p) => p !== une).slice(0, 6);
const dernieresSeries = await Promise.all(dernieres.map(serieDe));
const series = await seriesActives();
const univers = await universActifs();
const vitrine = pieces.find((p) => p.data.vitrine && p.data.coulisses?.images?.some((i) => 'avant' in i));
const vitrineSerie = vitrine ? await serieDe(vitrine) : undefined;
const paire = vitrine?.data.coulisses?.images?.find((i) => 'avant' in i) as { avant: string; apres: string; legende: { fr: string; en?: string } } | undefined;
const compteurs = pieces.length >= 8;
const offres = lang === 'fr'
  ? [
      ['Publicité IA déclinable', 'Un film de 15 à 30 secondes, décliné par marché, langue ou saison sans retournage.'],
      ['Film de marque', 'De 45 secondes à 3 minutes, pour une entreprise, un lieu, un recrutement.'],
      ['Série de marque', 'Votre marque intégrée dans une fiction à épisodes. VARENNE en est la démonstration.'],
      ['Film patrimonial', "L'histoire vraie d'une entreprise, en archives reconstituées. ROUVRAY en est la démonstration."],
    ]
  : [
      ['Adaptable AI commercial', 'A 15 to 30-second film, declined by market, language or season without reshooting.'],
      ['Brand film', 'From 45 seconds to 3 minutes, for a company, a place, a recruitment drive.'],
      ['Brand series', 'Your brand inside serial fiction. VARENNE is the demonstration.'],
      ['Heritage film', "A company's true story, in reconstructed archives. ROUVRAY is the demonstration."],
    ];
---
<Base lang={lang} titre={lang === 'fr' ? 'Films courts générés par IA' : 'Short films generated by AI'} description={d.site.description} alt={{ fr: '/', en: '/en/' }} jsonld={organisation} current="accueil" preload={une ? media(une, une.data.media.poster) + '-720.jpg' : undefined}>
  {une && (
    <section class="section container" aria-labelledby="une-titre">
      <div class="feature">
        <Lecteur piece={une} lang={lang} />
        <div class="feature__text">
          <div class="feature__kicker">
            <span class="label">{d.accueil.a_la_une}</span>
            {uneSerie && <span class="label label--ink">{t(lang, uneSerie.data.titre)} · {numero(une.data.saison, une.data.episode)}</span>}
            <span class="label num">{duree(lang, une.data.duree_s.fr)}</span>
          </div>
          <h2 class="feature__titre" id="une-titre">{t(lang, une.data.titre)}</h2>
          <p class="lede">{t(lang, une.data.pitch)}</p>
          <div class="feature__actions">
            <a class="btn btn--primary" href={urlPiece(lang, une, uneSerie)}>{d.accueil.voir_film}</a>
            {uneSerie && <a class="btn btn--ghost" href={urlSerie(lang, uneSerie)}>{d.fiche.serie}</a>}
          </div>
          {uneSerie?.data.mention && <p class="block__note">{t(lang, uneSerie.data.mention)}</p>}
        </div>
      </div>
    </section>
  )}

  <section class="section container">
    <div class="promise">
      <h1>{d.site.promesse}</h1>
      <a class="btn btn--primary" href={route(lang, 'contact')}>{d.nav.contact}</a>
    </div>
  </section>

  {dernieres.length > 0 && (
    <section class="section container" aria-labelledby="dernieres-titre">
      <div class="section__head">
        <h2 id="dernieres-titre">{d.accueil.dernieres}</h2>
        <a class="section__link" href={route(lang, 'films')}>{d.accueil.tout_catalogue}{compteurs ? ` · ${pieces.length} ${d.accueil.films}` : ''}</a>
      </div>
      <div class="grid-cards">
        {dernieres.map((p, i) => <CartePiece piece={p} serie={dernieresSeries[i]} lang={lang} />)}
      </div>
    </section>
  )}

  {series.length > 0 && (
    <section class="section container" aria-labelledby="series-titre">
      <div class="section__head">
        <h2 id="series-titre">{d.accueil.series}</h2>
      </div>
      <div class="series-list">
        {series.map(({ serie, episodes, dernier }) => (
          <a class:list={['serie-row', `serie-${serie.data.slug}`]} href={urlSerie(lang, serie)}>
            <span class="serie-row__mark">
              {serie.data.identite.logo ? <img src={serie.data.identite.logo} alt={t(lang, serie.data.titre)} width={96} height={96} /> : <span class="mono">{t(lang, serie.data.titre).charAt(0)}</span>}
            </span>
            <span class="serie-row__text">
              <h3>{t(lang, serie.data.titre)}</h3>
              <p>{t(lang, serie.data.sous_titre)}</p>
            </span>
            <span class="serie-row__status">
              <span class="label label--ink">{episodes.length ? `${episodes.length} ${lang === 'fr' ? 'épisode' : 'episode'}${episodes.length > 1 ? 's' : ''}` : d.serie.en_preparation}</span>
              {serie.data.rythme && serie.data.statut === 'en-cours' && <span class="label">{t(lang, serie.data.rythme)}</span>}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {vitrine && paire && (
    <section class="section container" aria-labelledby="comment-titre">
      <div class="howto">
        <Comparateur lang={lang} id="accueil-cmp" avant={paire.avant} apres={paire.apres} legende={paire.legende} />
        <div class="howto__text">
          <h2 id="comment-titre">{d.accueil.comment}</h2>
          <p class="lede">{lang === 'fr'
            ? 'Chaque film part d’une image fixe validée, plan par plan. L’animation, la voix et le montage viennent après. Sur chaque fiche, on dit ce qui était difficile et ce qu’on a appris.'
            : 'Every film starts from an approved still image, shot by shot. Animation, voice and editing come afterwards. On every page, we say what was hard and what we learned.'}</p>
          <p><a href={route(lang, 'methode')}>{d.accueil.comment_lien}</a> · <a href={urlPiece(lang, vitrine, vitrineSerie)}>{t(lang, vitrine.data.titre)}</a></p>
        </div>
      </div>
    </section>
  )}

  {univers.length > 0 && (
    <section class="section container" aria-labelledby="univers-titre">
      <div class="section__head">
        <h2 id="univers-titre">{d.accueil.univers}</h2>
      </div>
      <div class="univers-list">
        {univers.map((u) => (
          <a class="univers-row" href={route(lang, 'univers', `${u.id}/`)}>
            <h3>{t(lang, u.nom)}</h3>
            <p>{t(lang, u.description)}</p>
            <span class="label num">{u.n} {u.n > 1 ? d.accueil.films : (lang === 'fr' ? 'film' : 'film')}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section container" aria-labelledby="prestations-titre">
    <div class="section__head">
      <h2 id="prestations-titre">{d.accueil.prestations}</h2>
      <a class="section__link" href={route(lang, 'prestations')}>{d.accueil.prestations_lien}</a>
    </div>
    <div class="offres">
      {offres.map(([titre, texte]) => (
        <div class="offre"><h3>{titre}</h3><p>{texte}</p><a href={route(lang, 'contact')}>{d.nav.contact}</a></div>
      ))}
    </div>
  </section>

  <section class="section container" aria-labelledby="roger-titre">
    <div class="roger">
      <picture>
        <source srcset="/media/roger/portrait.avif" type="image/avif" />
        <source srcset="/media/roger/portrait.webp" type="image/webp" />
        <img src="/media/roger/portrait.webp" alt={lang === 'fr' ? 'Roger, portrait de casting' : 'Roger, casting portrait'} width={382} height={569} loading="lazy" decoding="async" />
      </picture>
      <div class="roger__text">
        <h2 id="roger-titre">{d.accueil.roger}</h2>
        <p>{lang === 'fr'
          ? 'Roger est à l’affiche de tous nos films. Pour quelqu’un qui n’existe pas, il se plaint beaucoup de son dos.'
          : 'Roger headlines every one of our films. For someone who does not exist, he complains a lot about his back.'}</p>
        <p><a href={route(lang, 'roger')}>{d.accueil.roger_lien}</a></p>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="final">
      <h2>{lang === 'fr' ? 'Un film pour votre marque, fabriqué de la même façon.' : 'A film for your brand, made the same way.'}</h2>
      <a class="btn btn--primary" href={route(lang, 'contact')}>{d.nav.contact}</a>
    </div>
  </section>
  <script src="../scripts/cards.ts"></script>
</Base>
