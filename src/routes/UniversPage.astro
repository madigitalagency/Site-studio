---
import Base from '../layouts/Base.astro';
import CartePiece from '../components/CartePiece.astro';
import { ui, t, route, type Lang } from '../lib/i18n';
import { catalogue, serieDe, universDe } from '../lib/content';
import { breadcrumb } from '../lib/jsonld';

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const d = ui(lang);
const u = universDe(id);
const pieces = (await catalogue()).filter((p) => p.data.univers.includes(id));
const series = await Promise.all(pieces.map(serieDe));
const alt = { fr: route('fr', 'univers', `${id}/`), en: route('en', 'univers', `${id}/`) };
const jsonld = breadcrumb([{ name: d.nav.univers, url: route(lang, 'univers') }, { name: t(lang, u.nom), url: route(lang, 'univers', `${id}/`) }]);
---
<Base lang={lang} titre={t(lang, u.nom)} description={t(lang, u.description)} alt={alt} jsonld={jsonld} current="univers">
  <div class="container">
    <header class="page-head">
      <nav class="fiche__crumb" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}><a href={route(lang, 'univers')}>{d.nav.univers}</a></nav>
      <h1>{t(lang, u.nom)}</h1>
      <p class="lede">{t(lang, u.description)}</p>
    </header>
    <section class="section" aria-label={t(lang, u.nom)}>
      <div class="grid-cards">
        {pieces.map((p, i) => <CartePiece piece={p} serie={series[i]} lang={lang} />)}
      </div>
    </section>
    <section class="section">
      <div class="cta-band">
        <h2 class="card__titre">{d.fiche.cta}</h2>
        <div><a class="btn btn--primary" href={route(lang, 'contact')}>{d.nav.contact}</a></div>
      </div>
    </section>
  </div>
  <script src="../scripts/cards.ts"></script>
</Base>
